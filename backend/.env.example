# OrbitOPedia Backend - Environment Variables
# Copy this file to .env and fill in your values

# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ────────────────────────────────────────
# Cloud-hosted MongoDB - create a free cluster at https://www.mongodb.com/atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/orbitopedia?retryWrites=true&w=majority

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://orbitopedia.vercel.app

# ── NASA API ─────────────────────────────────────────────
# Get a free key at https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# ── AWS (Optional) ───────────────────────────────────────
# Used for S3 storage of TLE snapshots and rocket images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=orbitopedia-assets

# ── Google Cloud (Optional) ──────────────────────────────
# Alternative to AWS - used for Cloud Storage and Cloud Run deployment
GCP_PROJECT_ID=
GCP_STORAGE_BUCKET=orbitopedia-assets

# ── TLE Data Source ──────────────────────────────────────
# Primary URL for fetching active satellite TLE data
TLE_SOURCE_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=tle

# ── Cache TTL (seconds) ──────────────────────────────────
# How long to cache TLE data before re-fetching from Celestrak
TLE_CACHE_TTL=3600
